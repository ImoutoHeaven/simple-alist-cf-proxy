{
  "controller": {
    "url": "",
    "apiPrefix": "/api/v0",
    "apiToken": "",
    "env": "",
    "role": "concurrency-handler",
    "instanceId": "",
    "appName": "concurrency-handler",
    "appVersion": ""
  },
  "listen": ":8081",
  "logLevel": "info",
  "auth": {
    "enabled": true,
    "header": "X-CQ-Auth",
    "token": "change-me"
  },
  "backend": {
    "mode": "postgres",
    "postgrest": {
      "baseUrl": "https://your-postgrest-endpoint.example.com",
      "authHeader": "Bearer your-postgrest-token"
    },
    "postgres": {
      "dsn": "postgres://user:pass@host:5432/dbname?sslmode=disable"
    }
  },
  "concurrency": {
    "caps": {
      "hostMaxInFlight": 64,
      "siteMaxInFlight": 32,
      "siteIpMaxInFlight": 4
    },
    "lease": {
      "requireHardExpiry": true,
      "maxFutureTtlSeconds": 7200
    },
    "sweep": {
      "enabled": true,
      "intervalSeconds": 300,
      "batchSize": 500
    },
    "rpc": {
      "acquireFunc": "cq_acquire",
      "releaseFunc": "cq_release",
      "expireFunc": "cq_expire_scope"
    }
  }
}
