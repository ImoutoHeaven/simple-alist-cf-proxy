{
  "controller": {
    "url": "",
    "apiPrefix": "/api/v0",
    "apiToken": "",
    "env": "",
    "role": "concurrency-handler",
    "instanceId": "",
    "appName": "concurrency-handler",
    "appVersion": ""
  },
  "listen": ":8081",
  "logLevel": "info",
  "auth": {
    "enabled": true,
    "header": "X-CQ-Auth",
    "token": "replace-with-cq-auth-token"
  },
  "backend": {
    "mode": "postgres",
    "ticketStateTable": "DOWNLOAD_TICKET_STATE_TABLE",
    "postgrest": {
      "baseUrl": "https://your-postgrest-endpoint.example.com",
      "authHeader": "Bearer your-postgrest-token"
    },
    "postgres": {
      "dsn": "postgres://user:pass@host:5432/dbname?sslmode=disable"
    }
  },
  "concurrency": {
    "caps": {
      "hostMaxInFlight": 0,
      "siteMaxInFlight": 32,
      "siteIpMaxInFlight": 4
    },
    "lease": {
      "requireHardExpiry": true
    },
    "wait": {
      "waitPollWindowMs": 10000,
      "waitReconnectGraceMs": 1500
    },
    "sweep": {
      "enabled": true,
      "intervalSeconds": 300,
      "batchSize": 500
    },
    "heartbeat": {
      "enabled": true,
      "required": true,
      "intervalMs": 5000,
      "timeoutMs": 15000,
      "reconnectGraceMs": 12000,
      "helloTimeoutMs": 2000,
      "startTimeoutMs": 7000,
      "ackTimeoutMs": 2000,
      "schedulerBatchSize": 500
    },
    "rpc": {
      "acquireFunc": "cq_acquire",
      "releaseFunc": "cq_release",
      "expireFunc": "cq_expire_scope"
    }
  }
}
