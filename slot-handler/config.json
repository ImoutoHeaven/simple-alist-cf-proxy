{
  "notes": "Download tickets now use payload/payloadSign; see controller common.binding defaults.",
  "controller": {
    "url": "",
    "apiPrefix": "/api/v0",
    "apiToken": "",
    "env": "",
    "role": "slot-handler",
    "instanceId": "",
    "appName": "slot-handler",
    "appVersion": ""
  },
  "internalApiToken": "change-me",
  "listen": ":8080",
  "logLevel": "info",
  "auth": {
    "enabled": true,
    "header": "X-FQ-Auth",
    "token": "change-me"
  },
  "backend": {
    "mode": "postgrest",
    "postgrest": {
      "baseUrl": "https://your-postgrest-endpoint.example.com",
      "authHeader": "Bearer your-postgrest-token"
    },
    "postgres": {
      "dsn": "postgres://user:pass@host:5432/dbname?sslmode=disable"
    }
  },
  "fairQueue": {
    "pollIntervalMs": 500,
    "pollWindowMs": 6000,
    "minSlotHoldMs": 800,
    "smoothReleaseIntervalMs": null,
    "globalMaxWaiters": 500,
    "sessionIdleSeconds": 90,
    "zombieTimeoutSeconds": 30,
    "ipCooldownSeconds": 0,
    "weightedScheduler": {
      "enabled": false,
      "hotPendingFactor": 4,
      "hotPendingMin": 16,
      "coldAvgWaitMs": 500,
      "hotAvgWaitMs": 2300,
      "maxProbesPerCycle": 5,
      "baseWeight": 1,
      "weightPerWait": 1
    },
    "hostCaps": {
      "maxWaitMs": 60000,
      "maxSlotPerHost": 5,
      "maxWaitersPerHost": 50,
      "maxSlotPerIp": 1,
      "maxWaitersPerIp": 3
    },
    "siteCaps": {
      "maxWaitMs": 60000,
      "maxSlotPerSite": 5,
      "maxWaitersPerSite": 50,
      "maxSlotPerIp": 1,
      "maxWaitersPerIp": 3
    },
    "rpc": {
      "throttleCheckFunc": "fq_check_throttle",
      "registerWaiterFunc": "fq_register_waiter",
      "releaseWaiterFunc": "fq_release_waiter",
      "tryAcquireFunc": "fq_try_acquire_dual",
      "releaseFunc": "fq_release_dual"
    },
    "cleanup": {
      "enabled": true,
      "intervalSeconds": 1800,
      "queueDepthZombieTtlSeconds": 20
    }
  }
}
